<!DOCTYPE html>
<html lang="en-US" id="html">
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/search.css">
</head>
<body>
<%- include('components/layout/base-layout') %>

<div class="content">
    <header class="page-header">
        <h1>Start Your Search</h1>
        <h2>Find the right event for you</h2>
        <div class="divider-bar"></div>
    </header>
    <div class="search-input-wrapper">
        <label for="search-input" style="display:none;"></label>
        <input type="search" id="search-input" placeholder="Search...">
        <div id="search-divider"></div>
        <button id="search-button">Search</button>
    </div>
    <div id="search-results">
        <table class="results-table">
            <thead>
            <tr>
                <th>Category</th>
                <th>Name</th>
            </tr>
            </thead>
            <tbody id="search-results-body">
            <tr>
                <td colspan="2">No results found. Please enter a search term.</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>

<script src="/js/search.js"></script>
</body>
</html>