<!DOCTYPE html>
<html>

    <head>
        <meta charset="utf-8">
        <title>
            <%= title %>
        </title>
        <link rel="stylesheet" type="text/css" href="/css/bracket-setup.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/brackets-viewer@latest/dist/brackets-viewer.min.css" />
        <script type="text/javascript"
            src="https://cdn.jsdelivr.net/npm/brackets-viewer@latest/dist/brackets-viewer.min.js"></script>

    </head>
    <body>
        <div id="mainContainer">
            <div>
                <label for="numPlayers">Enter number of players:</label>
                <input id="numPlayers" type="text" />

                <label for="format">Format:</label>
                <select id="format" name="format">
                    <option value="double_elimination">Double Elimination</option>
                    <option value="single_elimination">Single Elimination</option>
                    <option value="round_robin">Round Robin</option>
                </select>

                <button id="saveButton">Save</button>
            </div>
        </div>

        <div id="bracketsViewerExample" class="brackets-viewer"></div>
        <script src="/js/bracket-setup.js"></script>
        
        <div id="modal" class="modal">
            <div id="modal-content" class="modal-content">
                <h3></h3>
                <label id="opponent1-label" for="opponent1">Opponent 1: </label><input type="number" id="opponent1"><br>
                <label id="opponent2-label" for="opponent2">Opponent 2: </label><input type="number" id="opponent2"><br>
                <button id="input-submit">Submit</button>
            </div>
        </div>
</html>