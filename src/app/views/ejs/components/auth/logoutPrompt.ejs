<head>
    <meta charset="utf-8">
    <title>Logout Prompt</title>
    <link rel="stylesheet" type="text/css" href="/css/components/auth/logoutPrompt.css">
</head>

<div class="modal-container">
    <div id="logoutPrompt" class="modal">
        <div class="modal-content">
            <div class="modal-body">
                <p>Are you sure you want to log out?</p>
            </div>
            <div class="modal-footer">
                <button class="btn" id="confirmLogoutBtn">Logout</button>
                <button class="btn cancel" id="logoutCancelBtn">Cancel</button>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="/js/components/auth/logoutPrompt.js"></script>
</div>
