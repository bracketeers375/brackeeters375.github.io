<div class="grid-list">
    <% events.map(event => { %>
        <article class="grid-item">
            <h3><%= event.event_name %></h3>
            <p>Start Date: <time datetime="<%= event.start_date %>"><%= new Date(event.start_date).toDateString() %></time></p>
            <p>End Date: <time datetime="<%= event.end_date || '' %>"><%= event.end_date ? new Date(event.end_date).toDateString() : 'Ongoing' %></time></p>
            <a href="/events/<%= event.event_id %>" class="button">View Event</a>
        </article>
    <% }); %>
</div>