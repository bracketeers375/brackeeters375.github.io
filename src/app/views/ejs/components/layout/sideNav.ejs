<style>
    .sidenav {
        height: 100%;
        width: 50px;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #1c1c1c;
        border-right: 1px solid #333;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .sidenav a {
        padding: 10px 0;
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 18px;
        width: 100%;
    }

    .sidenav a:hover {
        color: #fff;
        background-color: #333;
        border-radius: 4px;
    }

    #sidenav-container {
        display: flex;
    }

    #loginLogoutTrigger {
        margin-top: auto;
    }

    #loginLogoutTrigger.logged-out {
        background-color: #1947A4;
    }

    #loginLogoutTrigger.logged-in {
        background-color: #d9534f;
    }
</style>

<div id="sidenav-container">
    <div class="sidenav">
        <a href="/">
            <%- include('icons/_homeIcon') %>
        </a>
        <a href="/events">
            <%- include('icons/_exploreIcon') %>
        </a>
        <a style="cursor: pointer" id="loginLogoutTrigger" class="<%= userName ? 'logged-in' : 'logged-out' %>">
            <%- include('icons/_loginLogoutIcon') %>
        </a>
    </div>
</div>

<% if (!userName) { %>
    <%- include('../auth/loginModal') %>
<% } else { %>
    <%- include('../auth/logoutPrompt') %>
<% } %>