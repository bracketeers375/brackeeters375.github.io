<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/attendees.css">
</head>

<body>
<%- include('components/layout/base-layout') %>
<div id="mainContainer">
    <p id="titleText"><%= eventData.event_name%> - Attendees List</p>
</div>
<div id="errorContainer"></div>
<div id="tableContainer">
    <table id="myTable">
        <thead>
        <tr>
            <th>Player Name</th>
            <th>Entered Tournaments</th>
        </tr>
        </thead>
        <tbody id="attendeesTBody">
        <% if(participantsData) { %>
            <% for (const [key, value] of Object.entries(participantsData)) { %>
                <tr>
                    <td><%= value.username %></td>
                    <td><%= value.enteredTournaments.join(", ")%></td>
                </tr>
            <% } %>
        <% } %>
        </tbody>
    </table>
</div>

<!-- <script src="/js/attendees.js"></script> -->
</body>

</html>