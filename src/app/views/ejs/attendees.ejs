<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/attendees.css">
</head>

<body>
<div id="mainContainer">
    <p id="titleText">Attendees List</p>
    <label for="tourId">Enter tournament ID here:</label>
    <input id="tourId" type="text" />
</div>
<button id="search">Search for attendees:</button>
<div id="errorContainer"></div>
<div id="tableContainer">
    <table id="myTable">
        <thead>
        <tr>
            <th>Player Name</th>
            <th>Entered Games</th>
        </tr>
        </thead>
        <tbody id="attendeesTBody">
        </tbody>
    </table>
</div>

<script src="/js/attendees.js"></script>
</body>

</html>