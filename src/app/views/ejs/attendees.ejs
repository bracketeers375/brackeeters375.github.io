<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/attendees.css">
</head>
<body>
<%- include('components/layout/base-layout') %>

<header class="page-header">
    <h1><%= eventData.event_name %></h1>
    <h2>Attendees</h2>
    <div class="divider-bar"></div>
</header>

<div id="errorContainer"></div>
<div id="tableContainer">
    <table id="myTable">
        <thead>
        <tr>
            <th>Player Name</th>
            <th>Entered Tournaments</th>
        </tr>
        </thead>
        <tbody id="attendeesTBody">
        <% if (participantsData && participantsData.length > 0) { %>
            <% for (const participant of participantsData) { %>
                <tr>
                    <td><%= participant.username %></td>
                    <td><%= participant.enteredTournaments.join(", ")%></td>
                </tr>
            <% } %>
        <% } else { %>
            <tr>
                <td colspan="2">No attendees found.</td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>
<script src="/js/attendees.js"></script>
</body>
</html>