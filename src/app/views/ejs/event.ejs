<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/css/event.css">
</head>
<body>
<%- include('components/layout/base-layout') %>

<div class="content" style="text-align: center">
    <header class="page-header">
        <h1><%= event.event_name %></h1>
        <h2>Start: <%= new Date(event.start_date).toDateString() %> - End: <%= event.end_date ? new Date(event.end_date).toDateString() : 'Ongoing' %></h2>
        <div class="divider-bar"></div>
    </header>
    <span id="eventLinks">
            <a href="/events/<%= event.event_id %>/registrants" class="event-link">View Registrants</a>
        <% if (isRegistered) { %>
            <a id="event-leave-button" class="event-link">Leave Event</a>
        <% } else { %>
            <a id="event-register-button" class="event-link">Register For Event</a>
        <% } %>

        <% if (isAdmin) { %>
            <a href="/admin/events/<%= event.event_id %>/attendees" class="event-link">Admin - Attendees</a>
        <% } %>
    </span>
    <div class="grid-list">
        <% tournaments.forEach(tournament => { %>
            <div class="grid-item">
                <h3><%= tournament.tournament_name %></h3>
                <p>Game: <%= tournament.game_name %></p>
                <a href="/tournament/<%= tournament.tournament_id %>" class="button">View Tournament</a>
            </div>
        <% }); %>
    </div>
</div>

</body>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const eventJoinButton = document.getElementById('event-register-button');
        if (eventJoinButton) {
            eventJoinButton.addEventListener('click', () => {
                fetch(`/api/events/<%= event.event_id %>/register`, {
                    method: "POST",
                    credentials: "include"
                }).then((response) => {
                    if (response.status >= 400) {
                        return response.text().then((text) => {
                            throw new Error(text);
                        });
                    }
                    window.location.reload();
                }).catch(error => console.error('Error during registration:', error.message));
            });
        }

        const eventLeaveButton = document.getElementById('event-leave-button');
        if (eventLeaveButton) {
            eventLeaveButton.addEventListener('click', () => {
                fetch(`/api/events/<%= event.event_id %>/leave`, {
                    method: "POST",
                    credentials: "include"
                }).then((response) => {
                    if (response.status >= 400) {
                        return response.text().then((text) => {
                            throw new Error(text);
                        });
                    }
                    window.location.reload();
                }).catch(error => console.error('Error during leaving:', error.message));
            });
        }
    });
</script>
</html>