<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/css/event.css">
</head>
<body>
<%- include('partials/sideNav') %>

<div class="content">
    <header class="page-header">
        <h1><%= event.event_name %></h1>
        <h2>Start: <%= new Date(event.start_date).toDateString() %> - End: <%= event.end_date ? new Date(event.end_date).toDateString() : 'Ongoing' %></h2>
        <div class="divider-bar"></div>
    </header>

    <div class="grid-list">
        <% tournaments.forEach(tournament => { %>
            <div class="grid-item">
                <h3><%= tournament.tournament_name %></h3>
                <p>Game: <%= tournament.game_name %></p>
                <a href="/tournament/<%= tournament.tournament_id %>" class="button">View Tournament</a>
            </div>
        <% }); %>
    </div>
</div>
</body>
</html>