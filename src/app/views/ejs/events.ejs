<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/css/events.css">
</head>
<body>
<%- include('components/layout/sideNav') %>

<div class="content">
    <header class="page-header">
        <h1>Explore Events</h1>
        <h2>Find the right event for you</h2>
        <div class="divider-bar"></div>
    </header>
    <div class="tab-switch">
        <button id="openTab" class="active">Open Events</button>
        <button id="upcomingTab">Upcoming Events</button>
        <button id="closedTab">Closed Events</button>
    </div>
    <div id="eventsContainer">
        <%- include('components/events/eventList', { events: openEvents }) %>
    </div>
</div>
</body>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const openTab = document.getElementById("openTab");
        const upcomingTab = document.getElementById("upcomingTab");
        const closedTab = document.getElementById("closedTab");

        const callback = (tab) => {
            switch(tab) {
                case 'open':
                    fetch('/events/open')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById("eventsContainer").innerHTML = html;
                        });
                    break;
                case 'upcoming':
                    fetch('/events/upcoming')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById("eventsContainer").innerHTML = html;
                        });
                    break;
                case 'closed':
                    fetch('/events/closed')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById("eventsContainer").innerHTML = html;
                        });
                    break;
            }
        };

        openTab.onclick = () => {
            openTab.classList.add("active");
            upcomingTab.classList.remove("active");
            closedTab.classList.remove("active");
            callback('open');
        };

        upcomingTab.onclick = () => {
            upcomingTab.classList.add("active");
            openTab.classList.remove("active");
            closedTab.classList.remove("active");
            callback('upcoming');
        };

        closedTab.onclick = () => {
            closedTab.classList.add("active");
            openTab.classList.remove("active");
            upcomingTab.classList.remove("active");
            callback('closed');
        };
    });
</script>
</html>