<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/registrants.css">
</head>
<body>
<%- include('components/layout/base-layout') %>

<header class="page-header">
    <h1><%= eventData.event_name %></h1>
    <h2>Registrants</h2>
    <div class="divider-bar"></div>
</header>

<div id="errorContainer" class="error-message"></div>
<div id="tableContainer">
    <table id="registrantsTable">
        <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody id="registrantsTBody">
        <% if (registrantsData && registrantsData.length > 0) { %>
            <% for (const registrant of registrantsData) { %>
                <tr>
                    <td><%= registrant.username %></td>
                    <td><%= registrant.email %></td>
                    <td class="actions-cell">
                        <%- include('components/event/addRegistrantToEventButton') %>
                        <%- include('components/event/removeRegistrantFromEventButton') %>
                    </td>
                </tr>
            <% } %>
        <% } else { %>
            <tr>
                <td colspan="3">No registrants found.</td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>
<script src="/js/registrants.js"></script>
</body>
</html>