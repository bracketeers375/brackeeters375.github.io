<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/brackets-viewer@latest/dist/brackets-viewer.min.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/brackets-viewer@latest/dist/brackets-viewer.min.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/tournament.css">
</head>
<body>
<%- include('components/layout/base-layout') %>

<% if(isAdmin) { %>
    <div id="modalMatch" class="modalMatch">
        <div id="modal-content-match" class="modalContentMatch">
            <h3></h3>
            <label id="opponent1-label" for="opponent1">Top Player: </label><input type="number" id="opponent1"><br>
            <label id="opponent2-label" for="opponent2">Bot Player: </label><input type="number" id="opponent2"><br>
            <button id="modal-submit">Submit</button>
            <button id="modal-cancel">Exit</button>
        </div>
    </div>
<% } %>

<div class="content">
    <header class="page-header">
        <h1><%= event.event_name %></h1>
        <h2><%= tournament.tournament_name %></h2>
        <div class="divider-bar"></div>
    </header>

    <div id="bracketsViewer" class="brackets-viewer"></div>
</div>

<script>
    let tournament_data;
    window.onclick = function (event) {
            console.log("test window");
            console.log(event);
            if (event.target == modalMatch) {
                modalMatch.style.display = "none";
            }
        };

    document.addEventListener('DOMContentLoaded', () => {
        fetch(`/api/tournaments/get/<%= tournament.tournament_id %>`)
            .then(response => response.json())
            .then(body => {
                tournament_data = body.tournament_json;
                console.log("tournament_data", tournament_data);
                renderBracket(body.tournament_json);
            })
            .catch(error => console.error('Error loading tournament:', error));
    });

    function renderBracket(data) {
        document.getElementById("bracketsViewer").innerHTML = "";

        window.bracketsViewer.render(
            {
                stages: data.stage,
                matches: data.match,
                matchGames: data.match_game,
                participants: data.participant,
            },
            {
                selector: "#bracketsViewer",
                participantOriginPlacement: "before",
                separatedChildCountLabel: true,
                showSlotsOrigin: true,
                showLowerBracketSlotsOrigin: true,
                highlightParticipantOnHover: true,
            }
        );
    }

    window.bracketsViewer.onMatchClicked = async (match) => {
        console.log("match: ", match);
        openModal(match);
        
        const updateMatch = async () => {
            const p1Score = parseInt(document.getElementById("opponent1").value);
            const p2Score = parseInt(document.getElementById("opponent2").value);
            console.log("P1: ", p1Score + " P2: " + p2Score);
            console.log("tournament data update", tournament_data);
            await window.bracketsManager.import(tournament_data);
            await window.bracketsManager.update.match({
                id: match.id,
                status: 4,
                opponent1: { score: p1Score },
                opponent2: { score: p2Score },
            });

            const newData = await window.bracketsManager.export();
            tournament_data = newData;

            console.log("new data", tournament_data);

            renderBracket(newData);
            fetch(`/api/tournaments/updateJsonForMatch/<%= tournament.tournament_id %>`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    tournament_json: tournament_data
                }),
            })
            .then((response) => {
                console.log("Response received: ", response.status);
                console.log("responese: ", response);

                if (response.status == 200) {
                    response.json().then((body) => {
                        console.log("body: ", body);
                    });
                }
            })
            .catch((error) => {
                console.log(error);
            });

        }

        let modalCancel = document.getElementById("modal-cancel");
        modalCancel.addEventListener("click", closeModal);

        let modalSubmit = document.getElementById("modal-submit");
        modalSubmit.addEventListener("click", updateMatch);
    };

        function openModal(match) {
            if(match.opponent1.hasOwnProperty("score") && match.opponent2.hasOwnProperty("score")) {
                document.getElementById("opponent1").value = match.opponent1.score;
                document.getElementById("opponent2").value = match.opponent2.score;
            } else {
                document.getElementById("opponent1").value = 0;
                document.getElementById("opponent2").value = 0;
            }

            let modal = document.getElementById("modalMatch");
            const matchTitle = document.querySelector(
                `[data-match-id="${match.id}"] .opponents > span`,
            ).textContent;
            modal.querySelector("h3").innerText = matchTitle;
            modal.style.display = "block";
        }

        function closeModal() {
            // console.log("test close");
            let modal = document.getElementById("modalMatch");
            modal.style.display = "none";
        }

        window.onclick = (event) => {
            if (event.target == modalMatch) {
                modal.style.display = "none";
            }
        };


</script>
<!-- <script src="/js/tournament.js"></script> -->

</body>
</html>